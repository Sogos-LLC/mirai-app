# Template for Mirai UAT application secrets
# Replace placeholders with actual values before applying
# DO NOT commit actual secrets to git
#
# For Stripe, use TEST MODE keys from Stripe dashboard
# Generate a new encryption key with: openssl rand -hex 32
---
apiVersion: v1
kind: Secret
metadata:
  name: mirai-uat-stripe-secret
  namespace: mirai-uat
  labels:
    environment: uat
type: Opaque
stringData:
  secret-key: $STRIPE_TEST_SECRET_KEY
  webhook-secret: $STRIPE_TEST_WEBHOOK_SECRET
  starter-price-id: $STRIPE_TEST_STARTER_PRICE_ID
  pro-price-id: $STRIPE_TEST_PRO_PRICE_ID
---
apiVersion: v1
kind: Secret
metadata:
  name: mirai-uat-encryption-secret
  namespace: mirai-uat
  labels:
    environment: uat
type: Opaque
stringData:
  encryption-key: $MIRAI_UAT_ENCRYPTION_KEY
---
# MinIO secret - can be copied from production if using same MinIO
# or create separate UAT bucket credentials
apiVersion: v1
kind: Secret
metadata:
  name: minio-secret
  namespace: mirai-uat
  labels:
    environment: uat
type: Opaque
stringData:
  endpoint: http://192.168.1.226:9768
  region: us-east-1
  accesskey: $MINIO_ACCESS_KEY
  secretkey: $MINIO_SECRET_KEY
