# Template for Kratos UAT secret
# Replace placeholders with actual values before applying
# DO NOT commit actual secrets to git
---
apiVersion: v1
kind: Secret
metadata:
  name: kratos-secret
  namespace: kratos-uat
  labels:
    environment: uat
type: Opaque
stringData:
  dsn: postgres://kratos:$KRATOS_UAT_DB_PASSWORD@kratos-uat-db-rw.kratos-uat.svc.cluster.local:5432/kratos?sslmode=disable
  secretsDefault: $KRATOS_UAT_SECRETS_DEFAULT
