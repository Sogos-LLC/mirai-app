# Template for Kratos UAT database credentials
# Replace $KRATOS_UAT_DB_PASSWORD with actual password before applying
# DO NOT commit actual passwords to git
---
apiVersion: v1
kind: Secret
metadata:
  name: kratos-uat-db-credentials
  namespace: kratos-uat
  labels:
    environment: uat
type: kubernetes.io/basic-auth
stringData:
  username: kratos
  password: $KRATOS_UAT_DB_PASSWORD
