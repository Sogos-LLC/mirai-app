# Template for UAT database credentials
# Replace $MIRAI_UAT_DB_PASSWORD with actual password before applying
# DO NOT commit actual passwords to git
---
apiVersion: v1
kind: Secret
metadata:
  name: mirai-uat-db-credentials
  namespace: mirai-uat
  labels:
    environment: uat
type: kubernetes.io/basic-auth
stringData:
  username: mirai
  password: $MIRAI_UAT_DB_PASSWORD
---
# DSN secret for application connection
apiVersion: v1
kind: Secret
metadata:
  name: mirai-uat-db-secret
  namespace: mirai-uat
  labels:
    environment: uat
type: Opaque
stringData:
  dsn: postgres://mirai:$MIRAI_UAT_DB_PASSWORD@mirai-uat-db-rw.mirai-uat.svc.cluster.local:5432/mirai?sslmode=disable
  password: $MIRAI_UAT_DB_PASSWORD
