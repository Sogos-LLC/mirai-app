---
# ============================================================================
# LOCAL DEVELOPMENT SECRETS - DO NOT USE IN PRODUCTION
# ============================================================================
# These are placeholder secrets for local k3d development only.
# All passwords and credentials here are for LOCAL USE ONLY.
# ============================================================================

# PostgreSQL Secret
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-local-secret
  namespace: mirai-local
  labels:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/component: database
    app.kubernetes.io/part-of: mirai
    app.kubernetes.io/environment: local
type: Opaque
stringData:
  postgres-password: "local-dev-password-postgres-change-me"

# Mirai Database Connection Secret (matches production format)
---
apiVersion: v1
kind: Secret
metadata:
  name: mirai-db-secret
  namespace: mirai-local
  labels:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/component: database
    app.kubernetes.io/part-of: mirai
    app.kubernetes.io/environment: local
type: Opaque
stringData:
  password: "local-dev-password-postgres-change-me"
  # Full DSN for Go backend - matches production format
  dsn: "postgres://postgres:local-dev-password-postgres-change-me@mirai-db.mirai-local.svc.cluster.local:5432/mirai?sslmode=disable"

# MinIO Secret (matches production format)
---
apiVersion: v1
kind: Secret
metadata:
  name: minio-local-secret
  namespace: mirai-local
  labels:
    app.kubernetes.io/name: minio
    app.kubernetes.io/component: storage
    app.kubernetes.io/part-of: mirai
    app.kubernetes.io/environment: local
type: Opaque
stringData:
  root-user: "minioadmin"
  root-password: "minioadmin-local-dev"

# MinIO Secret (production-compatible format for app consumption)
---
apiVersion: v1
kind: Secret
metadata:
  name: minio-secret
  namespace: mirai-local
  labels:
    app.kubernetes.io/name: minio
    app.kubernetes.io/component: storage
    app.kubernetes.io/part-of: mirai
    app.kubernetes.io/environment: local
type: Opaque
stringData:
  accesskey: "minioadmin"
  secretkey: "minioadmin-local-dev"
  endpoint: "http://minio.mirai-local.svc.cluster.local:9000"
  region: "us-east-1"

# Encryption Key Secret (for encrypting sensitive data like API keys)
---
apiVersion: v1
kind: Secret
metadata:
  name: mirai-encryption-secret
  namespace: mirai-local
  labels:
    app.kubernetes.io/name: mirai-backend
    app.kubernetes.io/component: backend
    app.kubernetes.io/part-of: mirai
    app.kubernetes.io/environment: local
type: Opaque
stringData:
  # 32-byte hex-encoded key for AES-256 encryption (64 hex characters)
  encryption-key: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Stripe Secret (LOCAL DEV ONLY - use test keys or placeholders)
---
apiVersion: v1
kind: Secret
metadata:
  name: mirai-stripe-secret
  namespace: mirai-local
  labels:
    app.kubernetes.io/name: mirai-backend
    app.kubernetes.io/component: backend
    app.kubernetes.io/part-of: mirai
    app.kubernetes.io/environment: local
type: Opaque
stringData:
  # Use Stripe test mode keys or placeholders for local dev
  secret-key: "sk_test_placeholder_local_dev"
  webhook-secret: "whsec_placeholder_local_dev"
  starter-price-id: "price_placeholder_starter"
  pro-price-id: "price_placeholder_pro"
