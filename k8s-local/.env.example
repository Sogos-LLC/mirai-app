# Mirai Local Development Environment Variables
# Copy this file to .env and fill in your real values
# Get these from your Stripe dashboard (Test mode)

# =============================================================================
# Stripe Configuration (required for registration/payment flows)
# =============================================================================

# Stripe Test Secret Key (from Stripe Dashboard -> Developers -> API Keys)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key

# Stripe Webhook Secret
# NOTE: For local development with `stripe listen`, the webhook secret changes
# every time you start it. Use ./stripe-webhook.sh to update it instead.
# This value is only used during initial setup.sh
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Stripe Price IDs (from Stripe Dashboard -> Products)
STRIPE_STARTER_PRICE_ID=price_your_starter_price_id
STRIPE_PRO_PRICE_ID=price_your_pro_price_id

# =============================================================================
# How to get these values from production cluster:
# =============================================================================
# kubectl --context <your-prod-context> get secret mirai-stripe-secret -n mirai -o jsonpath='{.data.secret-key}' | base64 -d
# kubectl --context <your-prod-context> get secret mirai-stripe-secret -n mirai -o jsonpath='{.data.starter-price-id}' | base64 -d
# kubectl --context <your-prod-context> get secret mirai-stripe-secret -n mirai -o jsonpath='{.data.pro-price-id}' | base64 -d

# =============================================================================
# Local Development Workflow:
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in STRIPE_SECRET_KEY and price IDs from Stripe Dashboard
# 3. Run ./setup.sh to create the cluster
# 4. Start Stripe webhook forwarding:
#    stripe listen --forward-to https://api.mirai.test/api/v1/billing/webhook
# 5. Copy the webhook secret and run:
#    ./stripe-webhook.sh whsec_your_secret_here
