# TLS Certificate Secret Template for Mirai Local Development
#
# This is a TEMPLATE file. Do not apply it directly!
#
# Generate local TLS certificates using mkcert and create the secret manually.
#
# Prerequisites:
# 1. Install mkcert: https://github.com/FiloSottile/mkcert
#    macOS: brew install mkcert
#    Linux: Follow instructions on GitHub
#
# 2. Install local CA:
#    mkcert -install
#
# Steps to create TLS secret:
# ============================
#
# 1. Generate certificate for all local domains:
#    cd /tmp
#    mkcert \
#      "mirai.local" \
#      "*.mirai.local" \
#      "get-mirai.local" \
#      "*.get-mirai.local"
#
#    This creates two files:
#    - mirai.local+3.pem (certificate)
#    - mirai.local+3-key.pem (private key)
#
# 2. Create the Kubernetes secret:
#    kubectl create secret tls mirai-local-tls \
#      --cert=mirai.local+3.pem \
#      --key=mirai.local+3-key.pem \
#      -n mirai
#
# 3. Verify the secret was created:
#    kubectl get secret mirai-local-tls -n mirai
#    kubectl describe secret mirai-local-tls -n mirai
#
# 4. Clean up temporary files:
#    rm mirai.local+3.pem mirai.local+3-key.pem
#
# Hosts File Configuration:
# ==========================
#
# Add these entries to /etc/hosts (requires sudo):
#
#   127.0.0.1 mirai.local
#   127.0.0.1 api.mirai.local
#   127.0.0.1 auth.mirai.local
#   127.0.0.1 get-mirai.local
#
# Or use this one-liner:
#   echo "127.0.0.1 mirai.local api.mirai.local auth.mirai.local get-mirai.local" | sudo tee -a /etc/hosts
#
# Verify DNS resolution:
#   ping mirai.local
#   curl -k https://mirai.local
#
# Certificate Renewal:
# ===================
#
# mkcert certificates don't expire, but if you need to regenerate:
# 1. Delete the old secret: kubectl delete secret mirai-local-tls -n mirai
# 2. Follow steps 1-3 above
# 3. Restart Traefik (optional): kubectl rollout restart deployment traefik -n kube-system
#
# Troubleshooting:
# ===============
#
# Certificate not trusted in browser:
# - Run: mkcert -install
# - Restart browser
# - Check: mkcert -CAROOT (shows CA certificate location)
#
# Connection refused:
# - Check Traefik is running: kubectl get pods -n kube-system | grep traefik
# - Check LoadBalancer IP: kubectl get svc traefik -n kube-system
# - Check IngressRoutes: kubectl get ingressroute -n mirai
#
# TLS handshake errors:
# - Verify secret exists: kubectl get secret mirai-local-tls -n mirai
# - Check certificate: kubectl get secret mirai-local-tls -n mirai -o jsonpath='{.data.tls\.crt}' | base64 -d | openssl x509 -text -noout
# - Check Traefik logs: kubectl logs -n kube-system deployment/traefik
#
# Example YAML (for reference only, use kubectl create command above):
# =====================================================================
#
# apiVersion: v1
# kind: Secret
# metadata:
#   name: mirai-local-tls
#   namespace: mirai
# type: kubernetes.io/tls
# data:
#   tls.crt: <base64-encoded-certificate>
#   tls.key: <base64-encoded-private-key>
