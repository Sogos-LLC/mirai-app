# Template for Kratos dev database credentials
# Replace $KRATOS_DEV_DB_PASSWORD with actual password before applying
# DO NOT commit actual passwords to git
---
apiVersion: v1
kind: Secret
metadata:
  name: kratos-local-dev-db-credentials
  namespace: kratos-local-dev
  labels:
    environment: dev
type: kubernetes.io/basic-auth
stringData:
  username: kratos
  password: $KRATOS_DEV_DB_PASSWORD
