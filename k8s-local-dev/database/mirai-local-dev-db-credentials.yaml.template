# Template for dev database credentials
# Replace $MIRAI_DEV_DB_PASSWORD with actual password before applying
# DO NOT commit actual passwords to git
---
apiVersion: v1
kind: Secret
metadata:
  name: mirai-local-dev-db-credentials
  namespace: mirai-local-dev
  labels:
    environment: dev
type: kubernetes.io/basic-auth
stringData:
  username: mirai
  password: $MIRAI_DEV_DB_PASSWORD
---
# DSN secret for application connection
apiVersion: v1
kind: Secret
metadata:
  name: mirai-local-dev-db-secret
  namespace: mirai-local-dev
  labels:
    environment: dev
type: Opaque
stringData:
  dsn: postgres://mirai:$MIRAI_DEV_DB_PASSWORD@mirai-local-dev-db-rw.mirai-local-dev.svc.cluster.local:5432/mirai?sslmode=disable
  password: $MIRAI_DEV_DB_PASSWORD
